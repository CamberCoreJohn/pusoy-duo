rules_version = '2';

// Kritzzz Firestore rules.
// Paste into Firebase console -> Firestore Database -> Rules -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Profiles: anyone signed in may read (needed for presence + code lookup
    // results); only the owner writes their own doc.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Friend-code directory: readable to signed-in users; a code doc may only
    // be claimed by its own account, and never overwritten.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Friendships: doc id is "uidA_uidB" (sorted). Only the two participants
    // can see or touch it. The requester creates it as pending; the OTHER
    // side accepts; either side may delete (decline / unfriend).
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && id == (request.resource.data.users[0] < request.resource.data.users[1]
              ? request.resource.data.users[0] + '_' + request.resource.data.users[1]
              : request.resource.data.users[1] + '_' + request.resource.data.users[0]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Invites: sender creates a ring; sender or recipient updates its status.
    match /invites/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'ringing';
      allow update: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
